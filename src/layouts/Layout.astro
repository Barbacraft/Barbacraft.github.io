---
import '../styles/global.css';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
  </head>
  <body>
    <slot />
  </body>
</html>